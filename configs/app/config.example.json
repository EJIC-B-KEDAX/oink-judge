{
    "grpc": {
        "channel_arguments_configurations": {
            "cdefault": {
                "grpc.keepalive_time_ms": 10000,
                "grpc.keepalive_timeout_ms": 5000,
                "grpc.keepalive_permit_without_calls": 1,
                "grpc.http2.max_pings_without_data": 0
            }
        }
    },
    "my_port": 8000,
    "logger": {
        "output_stream": "stderr",
        "log_levels": {
            "default": 1
        }
    },
    "database": {
        "host": "127.0.0.1",
        "port": 5432,
        "username": "my_username",
        "dbname": "my_dbname",
        "pool_min": 2,
        "pool_max": 10,
        "query_read_only_default": false,
        "query_timeout_sec": 0,
        "query_retries": 0,
        "default_executor": "connection_pool"
    },
    "directories": {
        "submissions": "submissions",
        "submissions_zip": "submissions/.zips",
        "problems": "problems",
        "problems_zip": "problems/.zips",
        "scripts": "scripts",
        "plugins": "build/plugins/app"
    },
    "content_storage": {
        "stub_type": "content_service_stub(channel(127.0.0.1:9102, ssl_client(certs/ca.pem), auth(auth_token)))"
    },
    "dispatcher": {
        "stub_type": "dispatcher_service_stub(custom_channel(127.0.0.1:9101, cdefault, ssl_client(certs/ca.pem), auth(auth_token)))"
    },
    "redis": {
        "host": "127.0.0.1",
        "port": 6379
    },
    "auth": {
        "username_regex": "^[a-zA-Z0-9.\\-_?!()]{3,100}$",
        "session_ttl_seconds": 900,
        "refresh_token_ttl_seconds": 604800
    }
}