{
    "grpc": {
        "my_endpoint": "0.0.0.0:9102",
        "server_credentials": "ssl_server(certs/server.crt, certs/server.key)",
        "server_interceptors": [
            "auth_req(auth_token)"
        ]
    },
    "directories": {
        "submissions": "submissions",
        "submissions_zip": "submissions/.zips",
        "problems": "problems",
        "problems_zip": "problems/.zips",
        "scripts": "scripts",
        "certs": "certs",
        "plugins": "build/plugins/content_service"
    },
    "timings": {
        "full_rescan_interval": 3600
    },
    "logger": {
        "log_levels": {
            "default": 1
        }
    }
}