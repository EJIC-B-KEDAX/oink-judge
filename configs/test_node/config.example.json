{
    "grpc": {
        "channel_arguments_configurations": {
            "cdefault": {
                "grpc.keepalive_time_ms": 10000,
                "grpc.keepalive_timeout_ms": 5000,
                "grpc.keepalive_permit_without_calls": 1,
                "grpc.http2.max_pings_without_data": 0
            }
        }
    },
    "my_id": "my_test_node_id",
    "my_type": "default",
    "database": {
        "host": "127.0.0.1",
        "port": 5432,
        "username": "my_username",
        "dbname": "my_dbname",
        "pool_min": 2,
        "pool_max": 10
    },
    "directories": {
        "submissions": "test_node_venv/submissions",
        "submissions_zip": "test_node_venv/submissions/.zips",
        "problems": "test_node_venv/problems",
        "problems_zip": "test_node_venv/problems/.zips",
        "scripts": "scripts",
        "certs": "certs",
        "plugins": "build/plugins/test_node"
    },
    "timings": {
        "full_rescan_interval": 3600
    },
    "testing": {
        "meta_file": "logs/meta.txt",
        "checker_err_file": "logs/checker_err.txt",
        "checker_out_file": "logs/checker_out.txt"
    },
    "logger": {
        "log_levels": {
            "default": 1
        }
    },
    "content_storage": {
        "stub_type": "content_service_stub(channel(127.0.0.1:9102, ssl_client(certs/ca.pem), auth(auth_token)))"
    },
    "queue_manager_service": {
        "stub_type": "queue_manager_service_stub(custom_channel(127.0.0.1:9101, cdefault, ssl_client(certs/ca.pem), auth(auth_token)))"
    }
}